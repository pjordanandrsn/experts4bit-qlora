#!/bin/bash
# Pre-push guard — refuses private-lane material before it leaves the machine.
#
# ONE SOURCE OF TRUTH: this hook and .github/workflows/private-marker-guard.yml
# both scan with .github/private-markers.txt. They used to carry separate
# hardcoded logic, which meant CI could pass while the hook blocked (or worse,
# the reverse). If you change the patterns, both move together.
#
# Install:  ln -sf ../../scripts/hooks/pre-push .git/hooks/pre-push
# One file exemption, mirrored in the workflow: bench/dq11/DQ11-AMENDMENT-4.md, a sealed
# registration (pinned in science.sha256) committed before the guard learned the private-store URI scheme.
# Fixture exemptions and "#all-of:" rules come from .github/private-markers.txt, as in the workflow.
set -euo pipefail
fail() { echo "PRE-PUSH GUARD: $*" >&2; exit 1; }

PATS=$(mktemp)
# grep -f treats '#' lines as literal patterns and BLANK lines as match-all —
# strip both, or the scan matches every line in the repo (observed: 1603 hits).
grep -vE '^[[:space:]]*(#|$)' .github/private-markers.txt > "$PATS" || true
ADDPATS=$(mktemp)
grep -E '^#added-only: ' .github/private-markers.txt | sed 's/^#added-only: //' > "$ADDPATS" || true
n=$(wc -l < "$PATS" | tr -d ' ')
[ "$n" -ge 20 ] || fail "pattern file collapsed to $n patterns — refusing to run a toothless scan"

while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue

  if git ls-tree -r --name-only "$lsha" | grep -qE '(^|/)AGENT-'; then
    fail "tip tree contains AGENT-* planning docs (private-lane denylist)"
  fi

  # A fixture exemption stands only while the pushed fixture holds its pin.
  excl=()
  while read -r _ path cap pin; do
    git cat-file -e "$lsha:$path" 2>/dev/null || continue
    git show "$lsha:$path" | scripts/guard_fixture_pin.sh "$path" "$cap" "$pin" \
      || fail "$path no longer holds its #exempt-fixture pin"
    excl+=(":!$path")
  done < <(grep -E '^#exempt-fixture: ' .github/private-markers.txt)

  hits=$(git grep -n -I -E -i -f "$PATS" "$lsha" \
           -- . ':!.github/private-markers.txt' \
                ':!.github/workflows/private-marker-guard.yml' \
                ':!scripts/hooks/pre-push' \
                ':!bench/dq11/DQ11-AMENDMENT-4.md' ${excl[@]+"${excl[@]}"} 2>/dev/null \
         | grep -v 'guard-allow' || true)
  # "#all-of:" rules: every term must match the same line.
  while IFS= read -r rule; do
    read -r -a terms <<< "${rule#\#all-of: }"
    args=()
    for t in "${terms[@]}"; do
      [ "${#args[@]}" -eq 0 ] || args+=(--and)
      args+=(-e "$t")
    done
    more=$(git grep -n -I -E -i "${args[@]}" "$lsha" \
             -- . ':!.github/private-markers.txt' \
                  ':!.github/workflows/private-marker-guard.yml' \
                  ':!scripts/hooks/pre-push' \
                  ':!bench/dq11/DQ11-AMENDMENT-4.md' ${excl[@]+"${excl[@]}"} 2>/dev/null \
           | grep -v 'guard-allow' || true)
    [ -z "$more" ] || hits="${hits}${hits:+$'\n'}${more}"
  done < <(grep -E '^#all-of: ' .github/private-markers.txt)
  # "#added-only:" rules: only the lines this push ADDS (merged history keeps its old mentions), as in the workflow.
  if [ -s "$ADDPATS" ]; then
    if [ "$_rsha" != "0000000000000000000000000000000000000000" ] && git cat-file -e "$_rsha^{commit}" 2>/dev/null \
       && git merge-base --is-ancestor "$_rsha" "$lsha"; then
      base=$_rsha
    else
      # a new branch, or a rebase/force-push whose old remote tip is not an ancestor: the default branch's merge base,
      # refreshed first so a stale local origin/main cannot widen the diff
      git fetch -q origin main 2>/dev/null || true
      base=$(git merge-base "$lsha" origin/main 2>/dev/null || true)
    fi
    if [ -n "$base" ]; then
      added=$(git diff -U0 --no-color "$base" "$lsha" -- . ':!.github/private-markers.txt' \
                ':!.github/workflows/private-marker-guard.yml' ':!scripts/hooks/pre-push' \
              | awk '/^\+\+\+ (b\/|\/dev\/null)/ { f = substr($0, 7); next } /^\+/ { print f ": " substr($0, 2) }' \
              | grep -v 'guard-allow' | grep -i -E -f "$ADDPATS" || true)
      [ -z "$added" ] || hits="${hits}${hits:+$'\n'}${added}"
    else
      echo "PRE-PUSH GUARD: no base for $lsha; the added-line check runs in CI" >&2
    fi
  fi
  if [ -n "$hits" ]; then
    # || true: under pipefail, head closing the pipe early would end the hook
    # with SIGPIPE (141) before the refusal below is printed.
    printf '%s\n' "$hits" | head -20 >&2 || true
    fail "private-lane markers in the tip tree (see above; 'guard-allow' to exempt a line)"
  fi
done
rm -f "$PATS" "$ADDPATS"
exit 0
