# Copy to `.env` beside docker-compose.yml and edit. The real `.env` is
# gitignored: it is per-host, and a tracked one on a public repo means any
# token added here later is published the moment it is committed.
#
# E4B_GPU_RUNTIME is LOAD-BEARING, not cosmetic. compose defaults it to
# `nvidia` (`runtime: ${E4B_GPU_RUNTIME:-nvidia}`), but a host whose Docker
# registers the runtime under a different name fails every service at create
# time with `unknown or invalid runtime name: nvidia`. Check with:
#     docker info --format '{{json .Runtimes}}'
# QNAP Container Station registers it as `nvidia-runtime`.
E4B_GPU_RUNTIME=nvidia-runtime

# name=path pairs, comma-separated. `base` (the un-tuned model) is always
# available and needs no entry here.
E4B_ADAPTERS=smoke=/adapters/adapter_smoke.pt,alpaca=/adapters/adapter_alpaca.pt
