repository-code: "https://github.com/pjordanandrsn/experts4bit-qlora"
url: "https://cerinamroth.com/ml/experts4bit-qlora/"
license: MIT
keywords:
  - mixture-of-experts
  - moe
  - qlora
  - quantization
  - nf4
  - mxfp4
  - gpu-offload
  - nvme
  - consumer-gpu
